# =============================================================================
# Data
# The CSVs are extracted from the .7z archives in data/. Keep the compressed
# source in git (small); regenerate the large CSVs locally before building:
#     7z x data/Food_Inspections.7z -odata/
#     7z x data/Food_Inspection_Violations.7z -odata/
# =============================================================================
/data/*.csv
/data/**/*.tsv

# =============================================================================
# Secrets / local config (never commit)
# =============================================================================
.env
**/.env
# TLS proxy self-signed cert + private key (generated by generate-cert.sh)
src/infra/ollama/tls-proxy/certs/
# Generated Embedding Projector files (Block 1 demo; regenerable, can be large)
src/demo/block1/*.tsv
# Local Claude Code settings
.claude/settings.local.json

# =============================================================================
# OS / editor cruft
# =============================================================================
.DS_Store
Thumbs.db
*~
*.swp
.vscode/
.idea/

# =============================================================================
# Python (utility / embedding scripts)
# =============================================================================
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# =============================================================================
# Logs / temp
# =============================================================================
*.log
