# Copy to .env and fill in your Microsoft Foundry (Azure OpenAI) details, then
# export these before running rag.py:  set -a; . ./.env; set +a
#
# The same values fill the placeholders in the tsql/ scripts.

# Foundry / Azure OpenAI resource endpoint (no trailing path):
FOUNDRY_ENDPOINT=https://<resource>.openai.azure.com
FOUNDRY_API_KEY=<your-api-key>

# Deployment names (as created in the Foundry portal):
FOUNDRY_EMBED_DEPLOYMENT=text-embedding-3-small
FOUNDRY_CHAT_DEPLOYMENT=gpt-4o-mini

# API versions (adjust if your resource differs):
FOUNDRY_EMBED_API_VERSION=2024-02-01
FOUNDRY_CHAT_API_VERSION=2024-10-21

# Embedding dimension (text-embedding-3-small = 1536; -3-large = 3072):
EMBED_DIM=1536

# SQL Server connection (the Block 4 demo container by default):
SQL_CONNECTION_STRING=DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost,1433;UID=sa;PWD=WakeCounty!2025;Encrypt=yes;TrustServerCertificate=yes
