# Caddy config: terminate TLS on :8443 and reverse-proxy to the host's Ollama
# (plain HTTP on :11434). This gives SQL Server an HTTPS endpoint, which
# CREATE EXTERNAL MODEL requires. The cert/key are generated by generate-cert.sh.
{
	auto_https off
	admin off
}

https://:8443 {
	tls /certs/fullchain.crt /certs/ollama-proxy.key

	# Ollama runs on the Docker host; the container reaches it via host.docker.internal.
	# Rewrite the Host header to a local value so Ollama accepts the request.
	reverse_proxy host.docker.internal:11434 {
		header_up Host 127.0.0.1:11434
	}
}
