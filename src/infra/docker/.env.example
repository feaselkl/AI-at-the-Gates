# Copy to .env and adjust if desired. These are classroom defaults, not secrets.
#
# The SA password is baked into the image at build time. If you change it here,
# rebuild with:  docker build --build-arg MSSQL_SA_PASSWORD="$MSSQL_SA_PASSWORD" ...
# and connect with the same value.
MSSQL_SA_PASSWORD=WakeCounty!2025
